# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=7777
LOG_LEVEL=INFO

# PostgreSQL. docker-compose.yml provides this value automatically.
DATABASE_URL=postgresql+psycopg://agno:agno@localhost:5432/agno

# Model provider: openai | vllm | openai-like
MODEL_PROVIDER=openai
MODEL_ID=gpt-5.5
MODEL_BASE_URL=
MODEL_API_KEY=
# OpenAI adapter also reads OPENAI_API_KEY directly.
OPENAI_API_KEY=
# VLLM adapter also reads these directly.
VLLM_BASE_URL=http://localhost:8000/v1/
VLLM_API_KEY=local-token

# Memory is disabled until user identity semantics are deliberately configured.
MEMORY_ENABLED=false
HISTORY_RUNS=8

# Security. Production startup fails when AUTHORIZATION_ENABLED is false.
AUTHORIZATION_ENABLED=false
JWT_ALGORITHM=RS256
JWT_AUDIENCE=agent-api
# Put an escaped PEM here (\n) or mount a secret and adapt settings.py.
JWT_VERIFICATION_KEY=

# Comma-separated exact origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AgentOS features
TRACING_ENABLED=true
MCP_ENABLED=false
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
AGNO_TELEMETRY=false
